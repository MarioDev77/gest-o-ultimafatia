NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/nucleo
JWT_SECRET=gere-um-segredo-com-no-minimo-32-caracteres
FRONTEND_ORIGIN=http://localhost:3000

# Pasta onde os uploads (fotos de produto, comprovantes PIX) ficam salvos.
# Em produção no Railway, aponte pro caminho onde o Volume está montado
# (ex: /data/uploads) — sem isso os arquivos somem a cada novo deploy.
UPLOADS_DIR=uploads

# URL pública deste backend, usada pra montar os links de visualização das
# fotos (o navegador precisa de uma URL absoluta pra carregar um <img>).
# Em produção: https://seu-backend.up.railway.app
PUBLIC_URL=http://localhost:4000
